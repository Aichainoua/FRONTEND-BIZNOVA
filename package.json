{
  "name": "biznova-frontend",
  "version": "1.0.0",
  "description": "Application mobile Biznova : analyse financière prévisionnelle et suivi budgétaire (React Native / Expo)",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "build:android:local:debug": "cd android && ./gradlew assembleDebug",
    "build:android:local:release": "cd android && ./gradlew assembleRelease",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "expo": "~57.0.18",
    "expo-font": "~57.0.4",
    "expo-print": "~57.0.2",
    "expo-sharing": "~57.0.26",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.39.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0",
    "react-native-svg": "^15.15.5",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "private": false,
  "license": "MIT"
}
