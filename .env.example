# URL de l'API (B1 + B2). En mode démo, elle n'est pas appelée.
EXPO_PUBLIC_API_URL=http://localhost:3000/api
# true = l'app tourne sans back (données de démonstration en mémoire)
EXPO_PUBLIC_USE_MOCKS=true
# Pages légales (facultatif tant qu'elles n'existent pas)
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
