# Copier ce fichier en `.env` (ignoré par Git) pour l'activer.
# Les variables EXPO_PUBLIC_* sont lues au lancement de Metro : relancer `pnpm start` après modification.

# true  : charge l'entreprise de démonstration « Nova Studio » (septembre et octobre 2026),
#         dont les chiffres reproduisent exactement la maquette Figma.
# false : démarre sans donnée, avec l'écran de configuration de l'entreprise (comportement réel).
EXPO_PUBLIC_SEED_DATA=true
